{
  "enabled": "true",
  "increase-coverage": {
    "project-name": "corecooking",
    "target-branches": [
      "main",
      "master"
    ],
    "test-env-docker-stage": "test",
    "build-test-env-docker-stage-script-path": "tool/build-test-env-docker-stage.sh",
    "test-files-folders": [
      "CoreCooking.Models/Parsers/IngredientParser.cs"
    ],
    "source-test-file-paths": [
      {
        "source-file-path": "CoreCooking.Models/Parsers/IngredientParser.cs",
        "test-file-path": "CoreCooking.Tests/Parsers/IngredientParserTests.cs"
      }
    ],
    "test-command": "dotnet test",
    "coverage-type": "cobertura",
    "code-coverage-report-path": "CoreCooking.Tests/TestResults/coverage.cobertura.xml",
    "desired-coverage": 100,
    "max-iterations": 1,
    "max-number-of-test-cases": 6
  }
}
